# Satyameva — Environment Variables
# Copy this file to .env and fill in your values.
# The app loads .env automatically on startup (via python-dotenv).

# ── Flask ──────────────────────────────────────────────────────────────────────
# Change this to a long random string in production!
SECRET_KEY=satyameva-dev-key-change-in-production

# ── Database ───────────────────────────────────────────────────────────────────
# Leave unset to use SQLite (default for local dev).
# For PostgreSQL (Docker / production):
# DATABASE_URL=postgresql://satyameva:satyameva@db:5432/satyameva

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
# 1. Enable 2-Factor Authentication on your Google account.
# 2. Go to myaccount.google.com/apppasswords and create an App Password.
# 3. Paste it here (no spaces).
MAIL_USERNAME=your.gmail@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Gemini AI ──────────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs must include:  http://127.0.0.1:5000/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Microsoft OAuth ────────────────────────────────────────────────────────────
# Create an app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Redirect URI:  http://127.0.0.1:5000/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_TENANT=common   # or your specific tenant ID for single-org apps
